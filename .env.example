APP_NAME="Odin CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Ho_Chi_Minh

LOG_CHANNEL=stack
LOG_LEVEL=debug

# CSDL MySQL: import "dataset demo SQL/odin.sql" trước (tạo database `odin`)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=odin
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@odin.example"
MAIL_FROM_NAME="${APP_NAME}"

# Thanh toán chuyển khoản: tài khoản nhận tiền (QR VietQR) + khóa bí mật webhook ngân hàng / cổng QR
VIETQR_BANK_ID=VCB
VIETQR_ACCOUNT_NO=0000000000
VIETQR_ACCOUNT_NAME="ODIN LANGUAGE ACADEMY"
BANK_WEBHOOK_SECRET=
# Nút "Giả lập giao dịch" để demo (mặc định bật khi APP_ENV=local)
# PAYMENT_SIMULATION=true
